{
  "seed": 42,
  "upstream": "https://github.com/protectskills/MaliciousSkillBench/blob/893afd609be22a2dfac5a2b94bbebb4eeb99515e/baselines/run_baselines.py",
  "tfidf": {
    "ngram_range": [
