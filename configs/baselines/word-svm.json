    "random_state": 42,
    "max_iter": 6000
  },
  "table_rule": {
    "threshold": 0,
    "comparator": ">="
  },
  "estimator_native_rule": {
    "threshold": 0,
    "comparator": ">"
  },
  "note": "Vocabulary, IDF, and estimator fit train only; original exact zero-margin convention differs from Table 1 convention and is recorded separately.",
  "original_source": "scripts/word_svm.py",
